#!/usr/bin/env node
'use strict';
// brain —— brain-kit 统一入口。机制不装内容，按注册表（~/.config/brain/vaults.json）服务多个 vault。
//   brain brief|lint|ingest|sessions|check|snap|snapshot|now|open [args]   对当前库跑（--vault <路径> 指定）
//   brain find <关键词…> [-n 8] [--all]   零常驻全文检索当前库（中英关键词都写；--all 跨库）
//   brain daily                    注册表里每个 daily 库：ingest → lint → snapshot（systemd 06:00 调）
//   brain init <目录> [选项]        铺空库骨架 + register
//   brain register <目录> [--name N --include <前缀>… --default --no-daily]
//   brain upgrade [--vault p]      刷各库 CLAUDE.md 通用块 / hooks / skills 软链 + 全局片段 / 全局 hooks / systemd
//   brain sec ls | env NAME[,…] -- cmd | stdin NAME -- cmd | check   用凭据不读凭据（库外 ~/Private/secrets）
//   brain doctor | list | which [cwd] | help
const fs = require('fs'); const path = require('path'); const os = require('os');
const { spawnSync } = require('child_process');
const KIT = path.resolve(__dirname, '..'); const LIB = path.join(KIT, 'lib'); const HOME = os.homedir();
const R = require(path.join(LIB, 'registry.js'));
const argv = process.argv.slice(2); const cmd = argv[0] || 'help'; const rest = argv.slice(1);
const die = m => { console.error(m); process.exit(1); };
const opt = n => { const i = rest.indexOf(n); if (i < 0) return null; const v = rest[i + 1]; rest.splice(i, 2); return v; };
const opts = n => { const out = []; let v; while ((v = opt(n)) !== null) out.push(v); return out; };
const flag = n => { const i = rest.indexOf(n); if (i < 0) return false; rest.splice(i, 1); return true; };
// 不存在 → null；存在但坏 JSON → 报错退出（曾经把坏文件当空对象再整文件覆盖，会把 settings.json 的 env/model/其他 hooks 全丢；审计 2026-09-03）
const readJson = p => { if (!fs.existsSync(p)) return null; try { return JSON.parse(fs.readFileSync(p, 'utf8')); } catch (e) { die(`${p} 不是合法 JSON（${e.message}）——修好再跑，brain 不覆盖它`); } };
const writeJson = (p, o) => { fs.mkdirSync(path.dirname(p), { recursive: true }); fs.writeFileSync(p, JSON.stringify(o, null, 2) + '\n'); };
const sh = (c, a, o = {}) => spawnSync(c, a, { encoding: 'utf8', ...o });
const brainTz = () => { try { return require(path.join(LIB, 'lib.js')).TZ; } catch { return process.env.BRAIN_TZ || 'Asia/Shanghai'; } };
const alive = pid => { try { process.kill(pid, 0); return true; } catch { return false; } };
const SCRIPTS = { brief: 'brief.js', lint: 'lint.js', ingest: 'ingest.js', sessions: 'sessions.js', check: 'check.js', snap: 'snap.js', find: 'find.js', now: 'now.js', open: 'open-in-obsidian.js' };
const NVM = 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1; ';
const hookCmd = (script, extra = '') => `bash -c '${NVM}BRAIN_ROOT="$CLAUDE_PROJECT_DIR" exec node "${KIT}/lib/${script}"${extra}'`;

function resolveVault() {
  const p = opt('--vault'); if (p) { const v = R.vaultAt(p) || { name: path.basename(p), path: R.real(p), include: [] }; return v; }
  const v = R.current(); if (!v) die('没有可用的 vault：先 `brain register <目录>` 或在库里跑');
  return v;
}
function runScript(script, args, vault, env = {}) {
  const r = spawnSync('node', [path.join(LIB, script), ...args], { stdio: 'inherit', env: { ...process.env, BRAIN_ROOT: vault.path, ...env } });
  return r.status ?? (r.error ? 1 : 0);   // 起不来（status null）也算失败
}
function vaultCfg(v) { return R.vaultConfig(v) || {}; }
function fill(text, v) {
  const c = vaultCfg(v); const reg = R.vaults().find(x => x.path === v.path) || v;
  const map = { NAME: v.name || path.basename(v.path), PATH: v.path, KIT,
    HUMAN_DIRS: (c.humanDirs || ['pages', 'digest', 'navigation', '_Private', '_system']).join(' / '), INCLUDE: (reg.include || []).join('、') || '（默认库：其他库不管的目录都归它）', MEDIA: path.join(path.dirname(v.path), 'library-media'),
    OBSIDIAN_VAULT: c.obsidianVault || path.basename(v.path) };   // Obsidian 里的库名默认=目录名；不同时 vault.json 填 obsidianVault
  return text.replace(/\{\{(\w+)\}\}/g, (m, k) => (k in map ? map[k] : m));
}
// 标记块替换：<!-- brain-kit:<id> start --> … <!-- brain-kit:<id> end -->
function renderBlock(file, id, body, { appendIfMissing = false } = {}) {
  const start = `<!-- brain-kit:${id} start -->`, end = `<!-- brain-kit:${id} end -->`;
  let s = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '';
  const eol = s.includes('\r\n') ? '\r\n' : '\n';   // 目标文件是 CRLF 就按 CRLF 写，别混行尾
  const block = `${start}\n${body.trim()}\n${end}`.replace(/\r?\n/g, eol);
  const i = s.indexOf(start), j = s.indexOf(end);
  if (i >= 0 && j > i) s = s.slice(0, i) + block + s.slice(j + end.length);
  // 追加时原样保留文件末尾（空行、行尾空格），removeBlock 才能还原；只有原文件末尾没换行时会补一个
  else if (appendIfMissing) s = s === '' ? block + eol : (s.endsWith('\n') ? s : s + eol) + eol + block + eol;
  else return false;
  fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, s.endsWith('\n') ? s : s + eol); return true;
}
function removeBlock(file, id) {
  const start = `<!-- brain-kit:${id} start -->`, end = `<!-- brain-kit:${id} end -->`;
  if (!fs.existsSync(file)) return false;
  const s = fs.readFileSync(file, 'utf8'); const i = s.indexOf(start), j = s.indexOf(end);
  if (i < 0 || j <= i) return false;
  let before = s.slice(0, i), after = s.slice(j + end.length).replace(/^\r?\n/, '');   // 只拿掉块本身和紧跟的一个换行
  if (/(\r?\n){2}$/.test(before)) before = before.replace(/\r?\n$/, '');            // 块前那一个空行也收掉，别处字节不动
  fs.writeFileSync(file, before + after); return true;
}
// 目标位置已有真实文件/目录（自己 clone 过的 skill、手写的 harvest、旧 brain 可执行文件）→ 改名留底，不删（审计 2026-09-03）
function link(target, linkPath) {
  try { const st = fs.lstatSync(linkPath); if (st.isSymbolicLink()) fs.unlinkSync(linkPath); else { const bak = `${linkPath}.bak-${new Date().toISOString().slice(0, 16).replace(/[-:T]/g, '')}`; fs.renameSync(linkPath, bak); console.log(`  ${linkPath} 不是软链，已改名留底 → ${bak}`); } } catch { /* 不存在 */ }
  fs.mkdirSync(path.dirname(linkPath), { recursive: true }); fs.symlinkSync(target, linkPath);
}

// ---- 每个库的接线：hooks / skills 软链 / CLAUDE.md 通用块 ----
function wireHooks(v) {
  const p = path.join(v.path, '.claude', 'settings.json'); const s = readJson(p) || {}; s.hooks = s.hooks || {};
  const set = (event, matcher, marker, command, { addIfMissing = true } = {}) => {
    const arr = s.hooks[event] = s.hooks[event] || [];
    for (const e of arr) for (const h of e.hooks || []) if (marker.some(m => (h.command || '').includes(m))) { h.command = command; if (matcher) e.matcher = matcher; return 'updated'; }
    if (!addIfMissing) return 'kept';
    arr.push({ ...(matcher ? { matcher } : {}), hooks: [{ type: 'command', command }] }); return 'added';
  };
  const out = {
    brief: set('SessionStart', null, ['/brief.js'], hookCmd('brief.js')),
    check: set('PostToolUse', 'Write|Edit', ['/check.js'], hookCmd('check.js')),
    // 旧式裸 git Stop hook（git add -A && push）一并换成 snap.js（陌生路径守卫；推不推由 vault.json checkpoint.push 定）
    snap: set('Stop', null, ['/snap.js', 'git add -A'], hookCmd('snap.js', ' checkpoint'), { addIfMissing: !(s.hooks.Stop || []).length }),
    guard: set('PreToolUse', 'Read|Bash|Grep|Glob', ['protect-secrets.js'], `bash -c '${NVM}exec node "${KIT}/lib/hooks/protect-secrets.js"'`, { addIfMissing: false }),
  };
  writeJson(p, s); return out;
}
function wireSkills(v) { const dir = path.join(v.path, '.claude', 'skills'); fs.mkdirSync(dir, { recursive: true }); let n = 0; for (const s of fs.readdirSync(path.join(KIT, 'skills'))) { if (s === 'harvest') continue; link(path.join(KIT, 'skills', s), path.join(dir, s)); n++; } return n; }
function wireCharter(v) { const core = fill(fs.readFileSync(path.join(KIT, 'charter', 'core.md'), 'utf8'), v); return renderBlock(path.join(v.path, 'CLAUDE.md'), 'core', core); }
function ensureVaultJson(v) { const p = path.join(v.path, '_system', 'vault.json'); const c = readJson(p) || {}; writeJson(p, c); return c; }

// 全局片段里的库清单（两处渲染共用一份；2026-10-25 起不再写 basic-memory 项目名，检索走 brain find）
const vaultList = vs => vs.map(v => `${v.name} = \`${v.path.replace(HOME, '~')}/_ai/memory\`${v.include.length ? `，管 ${v.include.map(x => x.replace(HOME, '~')).join('、')} 下的会话` : '，默认库'}`).join('；');

// 偏好送达（2026-10-25）：各库 _ai/memory/preferences.md 记的是用户明确说过的偏好，渲染进开场必读的指令文件——
// 默认库 → ~/.claude/CLAUDE.md 与 ~/.codex/AGENTS.md（全局）；有 include 的库 → 每个 include 目录的 CLAUDE.md
// （同目录 AGENTS.md 若是独立文件而不是指向它的软链，也写）。upgrade / upgrade --rules-only / daily 都会刷。
function wirePrefs(vs = R.vaults()) {
  const out = []; const real = f => { try { return fs.realpathSync(f); } catch { return f; } };
  for (const v of vs) {
    const src = path.join(v.path, '_ai', 'memory', 'preferences.md');
    const id = 'prefs-' + (v.name || path.basename(v.path)).toLowerCase().replace(/[^a-z0-9]+/g, '-');
    let targets;
    if (!v.include.length) targets = [path.join(HOME, '.claude', 'CLAUDE.md'), path.join(HOME, '.codex', 'AGENTS.md')];
    else {
      // include 目录：CLAUDE.md 给 Claude（逐级读上层，区下所有子目录和嵌套仓都读得到），AGENTS.md 给 Codex（缺就建指向 CLAUDE.md 的软链，独立文件则也写）。
      // Codex 在区里的嵌套 git 仓（如 proposal skill 仓、Work Vault）以仓为项目根，读不到区级 AGENTS.md，所以另渲染一份进全局 ~/.codex/AGENTS.md，标题写明适用范围
      targets = [];
      for (const d of v.include) {
        const c = path.join(d, 'CLAUDE.md'), a = path.join(d, 'AGENTS.md');
        targets.push(c);
        if (fs.existsSync(src) && !fs.existsSync(a)) { try { fs.symlinkSync('CLAUDE.md', a); out.push(`${a.replace(HOME, '~')} → CLAUDE.md 软链已建`); } catch (e) { out.push(`${a} 软链没建成：${e.message}`); } }
        if (fs.existsSync(a) && real(a) !== real(c)) targets.push(a);
      }
      targets.push(path.join(HOME, '.codex', 'AGENTS.md'));
      removeBlock(path.join(v.path, 'CLAUDE.md'), id);   // 早先也写进过库自己的 CLAUDE.md，对 Claude 是重复，收掉
    }
    if (!fs.existsSync(src)) { for (const t of targets) if (removeBlock(t, id)) out.push(`${t.replace(HOME, '~')} 去掉 ${v.name} 偏好块（源文件已删）`); continue; }
    const body = fs.readFileSync(src, 'utf8').replace(/\r\n?/g, '\n').replace(/^---\n[\s\S]*?\n---\n?/, '').trim();
    const scope = v.include.length ? `，只在 ${v.include.map(d => d.replace(HOME, '~')).join('、')} 下工作时适用` : '';
    const block = `## ${v.name} 里用户明确说过的偏好（渲染自 \`${src.replace(HOME, '~')}\`，改那份文件，别在这里改${scope}）\n\n${body}`;
    for (const t of [...new Set(targets.map(real))]) out.push(`${t.replace(HOME, '~')} ← ${v.name} 偏好 ${renderBlock(t, id, block, { appendIfMissing: true }) ? '✓' : '✗'}`);
  }
  return out;
}

// Codex 只从项目根往下读 AGENTS.md（项目根默认 = git 根，没有就只读当前目录），
// include 目录（如 ~/Workspace/Work）不是 git 仓时，其下会话读不到区级 AGENTS.md（2026-10-25 实测）。
// 办法：config.toml 的 project_root_markers 加 .agents-root，并在每个 include 目录放这个标记文件。
function wireCodexRoots(vs = R.vaults()) {
  const out = []; const cfg = path.join(HOME, '.codex', 'config.toml');
  if (fs.existsSync(cfg)) {
    const t = fs.readFileSync(cfg, 'utf8');
    if (!/^project_root_markers\s*=/m.test(t)) { fs.writeFileSync(cfg, 'project_root_markers = [".git", ".agents-root"]\n' + t); out.push('~/.codex/config.toml 加 project_root_markers ✓'); }
    else out.push(/^project_root_markers\s*=.*\.agents-root/m.test(t) ? 'codex project_root_markers ✓' : '⚠ ~/.codex/config.toml 已有 project_root_markers 但不含 .agents-root，手动加上');
  }
  for (const v of vs) for (const d of v.include) { const m = path.join(d, '.agents-root'); if (!fs.existsSync(m)) { fs.writeFileSync(m, ''); out.push(`${m.replace(HOME, '~')} 标记已建`); } }
  return out;
}

// ---- 全局接线：片段 / 全局 hooks / codex 适配 / skills / systemd / PATH ----
function wireGlobal() {
  const vs = R.vaults(); const lines = [];
  const snippet = f => { let t = fs.readFileSync(path.join(KIT, 'templates', 'global', f), 'utf8'); const list = vaultList(vs); return t.replace(/\{\{VAULTS\}\}/g, list).replace(/\{\{KIT\}\}/g, KIT); };
  lines.push(`~/.claude/CLAUDE.md 通用块 ${renderBlock(path.join(HOME, '.claude', 'CLAUDE.md'), 'global', snippet('CLAUDE.snippet.md'), { appendIfMissing: true }) ? '✓' : '✗'}`);
  lines.push(`~/.codex/AGENTS.md 通用块 ${renderBlock(path.join(HOME, '.codex', 'AGENTS.md'), 'global', snippet('AGENTS.snippet.md'), { appendIfMissing: true }) ? '✓' : '✗'}`);
  // 全局 hooks：protect-secrets（PreToolUse）。recall（SessionStart 按目录名搜 basic-memory）2026-10-25 撤掉，旧机器升级时顺手删
  const gp = path.join(HOME, '.claude', 'settings.json'); const g = readJson(gp) || {}; g.hooks = g.hooks || {};
  const gset = (event, matcher, marker, command) => { const arr = g.hooks[event] = g.hooks[event] || []; for (const e of arr) for (const h of e.hooks || []) if ((h.command || '').includes(marker)) { h.command = command; if (matcher) e.matcher = matcher; return; } arr.push({ ...(matcher ? { matcher } : {}), hooks: [{ type: 'command', command }] }); };
  gset('PreToolUse', 'Read|Bash|Grep|Glob', 'protect-secrets.js', `bash -c '${NVM}exec node "${KIT}/lib/hooks/protect-secrets.js"'`);
  for (const ev of Object.keys(g.hooks)) { g.hooks[ev] = (g.hooks[ev] || []).map(e => ({ ...e, hooks: (e.hooks || []).filter(h => !(h.command || '').includes('/lib/recall.js')) })).filter(e => (e.hooks || []).length); if (!g.hooks[ev].length) delete g.hooks[ev]; }
  writeJson(gp, g); lines.push('全局 hooks（protect-secrets）✓');
  // codex 护栏适配器
  const cp = path.join(HOME, '.codex', 'hooks', 'protect-secrets-codex.js');
  if (fs.existsSync(cp)) { const s = fs.readFileSync(cp, 'utf8').replace(/require\('[^']*protect-secrets\.js'\)/, `require('${KIT}/lib/hooks/protect-secrets.js')`); fs.writeFileSync(cp, s); lines.push('codex 护栏适配器 ✓'); }
  // skills：harvest 全局；kepano 五件给 codex（~/.agents/skills）
  link(path.join(KIT, 'skills', 'harvest'), path.join(HOME, '.claude', 'skills', 'harvest'));
  for (const s of fs.readdirSync(path.join(KIT, 'skills'))) link(path.join(KIT, 'skills', s), path.join(HOME, '.agents', 'skills', s));
  lines.push('skills 软链（~/.claude/skills/harvest，~/.agents/skills/*）✓');
  // systemd
  const ud = path.join(HOME, '.config', 'systemd', 'user'); fs.mkdirSync(ud, { recursive: true });
  // service/timer 都从模板渲染：node 用当前解释器（别的机器 node 只在 nvm 里，/usr/bin/node 不存在会静默死）；
  // timer 带 brain 时区——机器时区与人不一致时（本机 PDT vs 北京）"06:00" 必须按人的时区算（2026-09-03 实发：跑成北京 21:00）
  const tz = brainTz(); const map = { KIT, NODE: process.execPath, TZ: tz, HOME };
  const render = f => fs.readFileSync(path.join(KIT, 'templates', 'global', f), 'utf8').replace(/\{\{(\w+)\}\}/g, (m, k) => (k in map ? map[k] : m));
  const put = (name, text) => { const p = path.join(ud, name); const changed = !fs.existsSync(p) || fs.readFileSync(p, 'utf8') !== text; if (changed) fs.writeFileSync(p, text); return changed; };
  const sc = put('brain-daily.service', render('brain-daily.service')); const tc = put('brain-daily.timer', render('brain-daily.timer'));
  sh('systemctl', ['--user', 'daemon-reload']);
  if (sc || tc) sh('systemctl', ['--user', 'enable', '--now', 'brain-daily.timer']);
  if (tc) sh('systemctl', ['--user', 'restart', 'brain-daily.timer']);
  lines.push(`systemd brain-daily ${sc || tc ? '已刷新' : '✓'}（每日 06:00 ${tz}）`);
  // PATH
  const lb = path.join(HOME, '.local', 'bin'); fs.mkdirSync(lb, { recursive: true }); link(path.join(KIT, 'bin', 'brain'), path.join(lb, 'brain')); fs.chmodSync(path.join(KIT, 'bin', 'brain'), 0o755); lines.push('~/.local/bin/brain ✓');
  return lines;
}

function rulesSnippet(template) {
  const list = vaultList(R.vaults());
  return fs.readFileSync(path.join(KIT, 'templates/global', template), 'utf8').replace(/\{\{VAULTS\}\}/g, list).replace(/\{\{KIT\}\}/g, KIT);
}

// register/init 共用的参数解析：一次解析成对象（opt() 会从 rest 里摘走参数，二次解析会丢 --name/--include；审计 2026-09-03）
function regOpts() {
  const o = { name: opt('--name'), include: opts('--include'), isDefault: flag('--default'), noDaily: flag('--no-daily'), force: flag('--force') };
  o.dir = rest.find(a => !a.startsWith('--')); return o;
}
function doRegister(o) {
  if (!o.dir) die('用法: brain register <目录> [--name N] [--include 前缀 …] [--default] [--no-daily]');
  const entry = { path: R.real(o.dir), name: o.name || path.basename(R.real(o.dir)) };
  if (o.include.length) entry.include = o.include.map(R.real);
  if (o.isDefault) entry.default = true; entry.daily = !o.noDaily;
  const v = R.upsert(entry);
  ensureVaultJson(v);
  const hooks = wireHooks(v); const nSkills = wireSkills(v); const charter = wireCharter(v);
  console.log(`已登记 ${v.name} → ${v.path}\n  范围 ${(v.include || []).join('、') || '默认'}\n  hooks: ${Object.entries(hooks).map(([k, s]) => `${k} ${s}`).join(' · ')}\n  skills 软链 ${nSkills} 个 · CLAUDE.md 通用块 ${charter ? '已刷新' : '没有标记块（在 CLAUDE.md 里放 <!-- brain-kit:core start --> / end --> 再 brain upgrade）'}`);
  console.log(wireGlobal().map(l => '  ' + l).join('\n'));
}

const commands = {
  help() { console.log(fs.readFileSync(__filename, 'utf8').split('\n').slice(2, 11).map(l => l.replace(/^\/\/ ?/, '')).join('\n')); },
  list() { for (const v of R.vaults()) { const c = vaultCfg(v); console.log(`${v.name.padEnd(16)} ${v.path}  范围 ${v.include.length ? v.include.join('、') : '默认'} · daily ${v.daily !== false}`); } },
  which() { const c = rest[0] || process.cwd(); const v = R.vaultAt(c) || R.vaultFor(c); if (!v) die('无匹配 vault'); console.log(v.path); },
  snapshot() { const v = resolveVault(); process.exit(spawnSync('bash', [path.join(LIB, 'snapshot.sh')], { stdio: 'inherit', env: { ...process.env, BRAIN_ROOT: v.path } }).status || 0); },
  // sec 不认库：库外单一凭据存储，值进命令 env/stdin 不进上下文（ls/env/stdin/check）
  sec() { process.exit(spawnSync(process.execPath, [path.join(LIB, 'sec.js'), ...rest], { stdio: 'inherit' }).status || 0); },
  daily() {
    // 互斥锁：定时器撞上手动跑（或上一晚没跑完）就跳过
    const lock = path.join(path.dirname(R.REG), 'daily.lock');
    let pid = 0; try { pid = +fs.readFileSync(lock, 'utf8'); } catch { /* 无锁 */ }
    if (pid && pid !== process.pid && alive(pid)) die(`brain daily 已在跑（pid ${pid}），本次跳过`);
    fs.mkdirSync(path.dirname(lock), { recursive: true }); fs.writeFileSync(lock, String(process.pid));
    let failed = 0;
    try {
      for (const v of R.vaults()) {
        if (v.daily === false) continue;
        console.log(`=== brain daily @ ${v.path} ===`);
        // 库不在（外置盘/NAS 没挂、异机路径不同）就跳过：在挂载点上造影子骨架会把夜捞产物写进虚空
        if (!fs.existsSync(path.join(v.path, '_ai', 'memory'))) { console.log('库不在（未挂载？）跳过'); failed++; continue; }
        const st = {};
        // 夜间自动蒸会话（harvest-sweep）与向量索引（memory-index）2026-10-25 停用：记忆放在用它的地方，检索用 brain find
        for (const s of ['ingest.js', 'lint.js']) st[s.replace('.js', '')] = runScript(s, [], v);
        st.snapshot = spawnSync('bash', [path.join(LIB, 'snapshot.sh')], { stdio: 'inherit', env: { ...process.env, BRAIN_ROOT: v.path } }).status ?? 1;
        const dest = vaultCfg(v).assetsBackup;
        if (dest) {
          // 镜像不带 --delete：本机图片被误清时，备份不跟着清
          try { fs.mkdirSync(dest, { recursive: true }); const r1 = sh('rsync', ['-a', path.join(v.path, '_ai', 'library', 'assets') + '/', path.join(dest, 'assets') + '/']); const media = path.join(path.dirname(v.path), 'library-media'); const r2 = fs.existsSync(media) ? sh('rsync', ['-a', media + '/', path.join(dest, 'media') + '/']) : { status: 0 }; st.backup = (r1.status ?? 1) || (r2.status ?? 1); console.log(st.backup ? `图片/音视频 rsync 失败 exit ${st.backup}` : `图片/音视频已 rsync → ${dest}`); }
          catch (e) { st.backup = 1; console.log(`图片/音视频备份失败：${e.message}`); }
        }
        // 每日链状态戳（mtime 即心跳；brief 播报失败步骤，systemd 退出码也跟着非零）
        const bad = Object.entries(st).filter(([, c]) => c).map(([k, c]) => `${k}(exit ${c})`);
        try { fs.writeFileSync(path.join(v.path, '_system', '.lastrun-daily'), JSON.stringify({ at: new Date().toISOString(), steps: st, failed: bad }) + '\n'); } catch { /* 只读 */ }
        if (bad.length) { failed++; console.log(`步骤失败：${bad.join('、')}`); }
      }
      // 每日顺手重渲规则块和偏好块：偏好改了忘跑 upgrade --rules-only 也最多晚一天送达
      try { for (const v of R.vaults()) wireCharter(v); for (const [dest, template] of [['.codex/AGENTS.md', 'AGENTS.snippet.md'], ['.claude/CLAUDE.md', 'CLAUDE.snippet.md']]) renderBlock(path.join(HOME, dest), 'global', rulesSnippet(template)); wirePrefs(); } catch (e) { console.log(`规则/偏好重渲失败：${e.message}`); failed++; }
    } finally { try { fs.unlinkSync(lock); } catch { /* 无所谓 */ } }
    if (failed) process.exitCode = 1;
  },
  register() { doRegister(regOpts()); },
  init() {
    const o = regOpts(); if (!o.dir) die('用法: brain init <目录> [--name N] [--include 前缀 …] [--default] [--no-daily] [--force]');
    const abs = path.resolve(o.dir); fs.mkdirSync(abs, { recursive: true });
    const empty = !fs.readdirSync(abs).some(n => !n.startsWith('.'));
    const force = o.force || empty;
    if (!force) console.log(`${abs} 非空：只补缺的文件，不覆盖已有（--force 覆盖）`);
    const tpl = path.join(KIT, 'templates', 'vault');
    const v = { name: o.name || path.basename(abs), path: abs, include: o.include };
    // 先写 vault.json 让 fill() 有项目名
    ensureVaultJson(v, { project: o.project, library: o.library });
    const walk = d => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const src = path.join(d, e.name); const rel = path.relative(tpl, src); const dst = path.join(abs, rel); if (e.isDirectory()) { fs.mkdirSync(dst, { recursive: true }); walk(src); continue; } if (fs.existsSync(dst) && !force) continue; const txt = fs.readFileSync(src); fs.mkdirSync(path.dirname(dst), { recursive: true }); fs.writeFileSync(dst, /\.(md|json|base|txt)$/.test(e.name) ? fill(txt.toString('utf8'), v) : txt); } };
    walk(tpl);
    if (!fs.existsSync(path.join(abs, '.git'))) sh('git', ['init', '-q'], { cwd: abs });
    console.log(`骨架已铺 → ${abs}`);
    doRegister({ ...o, dir: abs });
    console.log(`下一步：Obsidian 打开该目录作为库（名字 ${v.name}），userIgnoreFilters 加 _ai/；改 CLAUDE.md 块外的本库专属规则；git remote 自定。`);
  },
  upgrade() {
    const rulesOnly = flag('--rules-only');
    const one = opt('--vault'); const vs = one ? [R.vaultAt(one) || { name: path.basename(one), path: R.real(one), include: [] }] : R.vaults();
    if (rulesOnly) {
      for (const v of vs) console.log(`${v.name}: CLAUDE.md ${wireCharter(v) ? 'rules refreshed' : 'no core marker'}`);
      if (one) for (const l of [...wireCodexRoots(vs), ...wirePrefs(vs)]) console.log(l);
      if (!one) {
        const sources = [['.codex/AGENTS.md', 'AGENTS.snippet.md'], ['.claude/CLAUDE.md', 'CLAUDE.snippet.md']];
        for (const [dest, template] of sources) {
          renderBlock(path.join(HOME, dest), 'global', rulesSnippet(template));
        }
        for (const l of [...wireCodexRoots(), ...wirePrefs()]) console.log(l);
      }
      return;
    }
    for (const v of vs) { const h = wireHooks(v); const n = wireSkills(v); const c = wireCharter(v); console.log(`${v.name}: hooks ${Object.values(h).join('/')} · skills ${n} · CLAUDE.md 通用块 ${c ? '已刷新' : '无标记块，跳过'}`); }
    if (!one) { console.log(wireGlobal().join('\n')); console.log([...wireCodexRoots(), ...wirePrefs()].join('\n')); }
    else console.log([...wireCodexRoots(vs), ...wirePrefs(vs)].join('\n'));
  },
  doctor() {
    const ok = (c, m) => console.log(`${c ? '✅' : '⚠️ '} ${m}`);
    ok(true, `kit ${KIT} · node ${process.version}`);
    ok((() => { try { require.resolve('gray-matter', { paths: [LIB] }); return true; } catch { return false; } })(), 'gray-matter 依赖（缺了就在 kit 根 npm i）');
    const vs = R.vaults(); ok(vs.length > 0, `注册表 ${R.REG}：${vs.length} 个库`);
    for (const v of vs) {
      const hooks = readJson(path.join(v.path, '.claude', 'settings.json')); const wired = JSON.stringify(hooks || {}).includes(`${KIT}/lib/brief.js`);
      ok(fs.existsSync(path.join(v.path, '_ai', 'memory')), `${v.name}: _ai/memory 在`); ok(wired, `${v.name}: hooks 指向 kit`);
      const charter = (() => { try { return fs.readFileSync(path.join(v.path, 'CLAUDE.md'), 'utf8'); } catch { return ''; } })(); ok(charter.includes('brain-kit:core start'), `${v.name}: CLAUDE.md 有通用块`);
      const ident = sh('git', ['config', 'user.email'], { cwd: v.path }).status === 0; const up = sh('git', ['rev-parse', '--abbrev-ref', '@{u}'], { cwd: v.path }).status === 0;
      ok(ident && up, `${v.name}: git 身份与上游在（快照提交/推送用）`);
    }
    ok(sh('obsidian', ['vaults']).status === 0, 'Obsidian CLI（app 开着）');
    ok(sh('yt-dlp', ['--version']).status === 0 && sh('ffmpeg', ['-version']).status === 0, 'yt-dlp + ffmpeg');
    ok(fs.existsSync(path.join(HOME, '.local', 'share', 'brain-asr', '.venv', 'bin', 'python')), 'faster-whisper venv（~/.local/share/brain-asr）');
    ok(sh('defuddle', ['--version']).status === 0, 'defuddle');
    ok((sh('systemctl', ['--user', 'is-active', 'brain-daily.timer']).stdout || '').trim() === 'active', 'systemd brain-daily.timer');
    const tz = brainTz(); const unit = n => { try { return fs.readFileSync(path.join(HOME, '.config', 'systemd', 'user', n), 'utf8'); } catch { return ''; } };
    ok(unit('brain-daily.timer').includes(` ${tz}`), `定时器按 brain 时区触发（${tz}）——不是就 brain upgrade`);
    const nodeBin = (/ExecStart=(\S+)/.exec(unit('brain-daily.service')) || [])[1]; ok(!!nodeBin && fs.existsSync(nodeBin), `service 的 node 在（${nodeBin || '?'}）`);
    const secStore = process.env.BRAIN_SECRETS || path.join(HOME, 'Private', 'secrets');
    if (fs.existsSync(secStore)) { const wide = fs.statSync(secStore).mode & 0o077; ok(!wide, `凭据存储 ${secStore}（brain sec；${wide ? '⚠权限过宽,chmod 600' : '600'}）`); }
    else ok(true, `凭据存储未建（可选；brain sec 用时在 ${secStore} 写 NAME=value）`);
    const g = readJson(path.join(HOME, '.claude', 'settings.json')); ok(!JSON.stringify(g || {}).includes('/lib/recall.js'), '全局没有 recall 钩子（2026-10-25 撤掉；还在就 brain upgrade）');
    ok(JSON.stringify(g || {}).includes(`${KIT}/lib/hooks/protect-secrets.js`), '全局 protect-secrets 指向 kit');
  },
};
for (const k of Object.keys(SCRIPTS)) commands[k] = () => { const v = resolveVault(); process.exit(runScript(SCRIPTS[k], rest, v)); };
if (!commands[cmd]) die(`未知命令 ${cmd}\n` + fs.readFileSync(__filename, 'utf8').split('\n').slice(2, 11).map(l => l.replace(/^\/\/ ?/, '')).join('\n'));
commands[cmd]();
